# Copy to .env for local development. Never commit a real .env (see
# .gitignore). Nothing in this file is a real secret.

OFFENSIVEX_ENVIRONMENT=development

# Must be a random string of at least 32 characters once
# OFFENSIVEX_ENVIRONMENT=production — see backend/src/offensivex/core/config.py.
# The empty default below is accepted only in development/test.
OFFENSIVEX_SECRET_KEY=

# Matches docker-compose.yml's postgres service (host port 5433).
OFFENSIVEX_DATABASE_URL=postgresql+psycopg://offensivex:offensivex@localhost:5433/offensivex

OFFENSIVEX_LOG_LEVEL=INFO

# --- Authentication (ADR-012 / ADR-013) -----------------------------------------
# There is NO default account. Create the first admin with:
#   python -m offensivex.admin create-user --username <name> --role admin
# Session lifetime, in minutes (absolute, not sliding).
# OFFENSIVEX_SESSION_TTL_MINUTES=480
# Failed logins per username before a 429 for the window below.
# OFFENSIVEX_LOGIN_MAX_FAILURES=5
# OFFENSIVEX_LOGIN_FAILURE_WINDOW_MINUTES=15
# Let an admin approve an authorization they submitted themselves. Leave false
# except for a single-user lab; it removes the separation of duties.
# OFFENSIVEX_ALLOW_SELF_APPROVAL=false
# Explicit browser origins allowed to call the API with cookies ('*' is rejected).
# OFFENSIVEX_API_CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (Track B) — leave disabled and nothing calls a model ---------------------
# Set ENABLED=true plus PROVIDER, MODEL and API_KEY to turn on the LLM-driven
# agents and the AI executive summary. Full reference:
# docs/architecture/llm-integration.md
# OFFENSIVEX_LLM_ENABLED=false
# anthropic | openai | local
# Gemini = provider openai + BASE_URL https://generativelanguage.googleapis.com/v1beta/openai/
# (required: without it the key would go to api.openai.com)
# OFFENSIVEX_LLM_PROVIDER=anthropic
# OFFENSIVEX_LLM_MODEL=
# OFFENSIVEX_LLM_API_KEY=
# Optional: a gateway/proxy, or the server for provider=local. Required for local.
# OFFENSIVEX_LLM_BASE_URL=
# Bounds (defaults shown): per-request timeout, retries after the first attempt,
# max output tokens per call, and the largest prompt that will be sent.
# OFFENSIVEX_LLM_TIMEOUT_SECONDS=60
# OFFENSIVEX_LLM_MAX_RETRIES=2
# OFFENSIVEX_LLM_MAX_OUTPUT_TOKENS=2048
# OFFENSIVEX_LLM_MAX_PROMPT_CHARS=60000

# --- ML advisory (ADR-026) — off by default; estimates only, never authoritative --
# Needs `pip install -e "backend[ml]"` and the artifacts under backend/models/
# (git-ignored; produced by notebooks 01/02). An artifact is loaded ONLY if its
# SHA-256 matches the pin below (joblib is pickle = code execution). Re-pin after
# every retrain. Pins for the 2026-10-14 Kaggle run (dataset fingerprint 85bab2ed…):
# OFFENSIVEX_ML_ADVISORY_ENABLED=true
# OFFENSIVEX_ML_ARTIFACT_PINS={"severity_regressor.joblib":"6a4346f3a7ccb0a8cfbcef4fd0ca8f4a5f6cfb8d971558f9a5a1c19f7243a87f","severity_classifier.joblib":"ca6b0f4d1e0eedd5114e6bf3036f8bbc58a375d06c7d82cf508b76546122aa35","exploit_likelihood_bundle.joblib":"4ddcc55459125f5a5f9d4cc441cf65d749450a794217eb0c367bb1aa7a665014"}
# Optional: models directory (default <repo>/backend/models)
# OFFENSIVEX_ML_MODELS_DIR=
